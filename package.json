{
  "name": "daypop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-release-assets.mjs",
    "dev": "vite",
    "release:assets": "node scripts/generate-release-assets.mjs",
    "prebuild": "node scripts/generate-release-assets.mjs",
    "build": "tsc -b && vite build",
    "check:build": "node scripts/check-build-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db --local supabase/tests/database",
    "supabase:test:linked": "supabase test db --linked supabase/tests/database",
    "supabase:types": "supabase gen types --lang typescript --local --schema public > src/lib/database.types.ts",
    "supabase:types:linked": "supabase gen types --lang typescript --linked --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/dotgothic16": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "^2.111.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.111.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
